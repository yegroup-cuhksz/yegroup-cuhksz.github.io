---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  linkHref?: string;
  linkLabel?: string;
  external?: boolean;
}

const { eyebrow, title, id, linkHref, linkLabel, external = false } = Astro.props;
---

<div class="section-heading">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id}>{title}</h2>
  </div>
  {
    linkHref && linkLabel && (
      <a class="text-link" href={linkHref}>
        {linkLabel}
        <span aria-hidden="true">{external ? '↗' : '→'}</span>
      </a>
    )
  }
</div>
