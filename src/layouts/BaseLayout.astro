---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { settings } from '../lib/content';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  absoluteTitle?: boolean;
  image?: string;
  noindex?: boolean;
  canonicalPath?: string;
}

const {
  title,
  description,
  absoluteTitle = false,
  image = settings.socialImage,
  noindex = false,
  canonicalPath,
} = Astro.props;

const documentTitle = absoluteTitle ? title : `${title} | ${settings.name}`;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, settings.domain).toString();
const socialImage = new URL(image, settings.domain).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#f7f6f1" />
    <title>{documentTitle}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>import '../scripts/site.ts';</script>
  </body>
</html>
