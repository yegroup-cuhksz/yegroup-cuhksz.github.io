---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PublicationList from '../components/PublicationList.astro';
import NewsList from '../components/NewsList.astro';
import GalleryPreview from '../components/GalleryPreview.astro';
import ActivityList from '../components/ActivityList.astro';
import LocalImage from '../components/LocalImage.astro';
import {
  albums,
  assertNewsReferences,
  featuredPublications,
  formatIsoDate,
  news,
  publications,
  publishedActivities,
  publishedNews,
  settings,
} from '../lib/content';

const memberEntries = await getCollection('members');
const openingEntries = await getCollection('openings');
const opening = openingEntries[0];
const openRoles = opening
  ? opening.data.roles.filter((role) => role.status === 'open')
  : [];
const openRoleLabel = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' }).format(
  openRoles.map((role) => role.title),
);
const researchEntries = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
const latestNews = publishedNews.slice(0, settings.homepage.newsLimit);
const albumPreviews = albums.slice(0, settings.homepage.galleryPreviewLimit);
const activityPreviews = publishedActivities.slice(0, settings.homepage.activityPreviewLimit);
const memberSlugs = memberEntries.map((entry) => entry.data.slug);

assertNewsReferences(news, {
  memberSlugs,
  publicationIds: publications.map((item) => item.id),
  albumSlugs: albums.map((album) => album.slug),
});

const solarPaper = featuredPublications.find((item) => item.id === 'xenonnt-solar-cevns-2024');
---

<BaseLayout
  title={`${settings.name} | ${settings.institutionShort}`}
  absoluteTitle
  description={settings.description}
>
  <section class="hero container" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="hero-kicker"><span class="status-dot"></span> Experimental particle physics</p>
      <h1 id="home-title">Neutrino <em>&amp;</em><br />Dark Matter Group</h1>
      <p class="hero-institution">{settings.institution}<br />{settings.school}</p>
      <p class="hero-description">
        We study dark matter, neutrinos and rare-event physics with noble-liquid detectors,
        including the XENONnT and RELICS experiments.
      </p>
      <div class="hero-actions">
        <a class="button" href="/research/">Explore our research <span aria-hidden="true">→</span></a>
        <a class="button button-light" href="/people/">Meet the group <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="hero-media">
      <div
        class="hero-carousel"
        id="hero-carousel"
        data-hero-carousel
        role="group"
        aria-roledescription="carousel"
        aria-label="Group photographs"
      >
        {
          settings.hero.slides.map((slide, index) => (
            <figure
              class:list={['hero-photo', 'hero-slide', { 'is-active': index === 0 }]}
              data-hero-slide
              role="group"
              aria-roledescription="slide"
              aria-label={`${index + 1} of ${settings.hero.slides.length}`}
              aria-hidden={index === 0 ? 'false' : 'true'}
            >
              <a class="hero-photo-link" href="/gallery/" aria-label="View the gallery">
                <LocalImage
                  src={slide.image}
                  alt={slide.alt}
                  sizes="(max-width: 820px) 100vw, 48vw"
                  loading={index === 0 ? 'eager' : 'lazy'}
                  fetchpriority={index === 0 ? 'high' : 'auto'}
                />
              </a>
              <figcaption>
                <span>{slide.caption}</span>
                <span>Fig. 0{index + 1} / Group</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      {
        settings.hero.slides.length > 1 && (
          <div class="hero-controls" data-hero-controls>
            <div class="hero-dots" role="group" aria-label="Choose a group photograph">
              {settings.hero.slides.map((slide, index) => (
                <button
                  type="button"
                  class="hero-dot"
                  data-hero-dot={index}
                  aria-label={`Show photograph ${index + 1} of ${settings.hero.slides.length}`}
                  aria-current={index === 0 ? 'true' : undefined}
                  aria-controls="hero-carousel"
                >
                  {index + 1}
                </button>
              ))}
            </div>
            <div class="hero-controls-actions">
              <p class="hero-position" data-hero-position aria-live="polite">
                1 / {settings.hero.slides.length}
              </p>
              <button
                type="button"
                class="hero-control"
                data-hero-prev
                aria-label="Previous photograph"
                aria-controls="hero-carousel"
              >
                ←
              </button>
              <button
                type="button"
                class="hero-control"
                data-hero-pause
                aria-label="Pause slideshow"
                aria-pressed="false"
                aria-controls="hero-carousel"
              >
                Pause
              </button>
              <button
                type="button"
                class="hero-control"
                data-hero-next
                aria-label="Next photograph"
                aria-controls="hero-carousel"
              >
                →
              </button>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="research-overview-title">
    <div class="container">
      <SectionHeading
        eyebrow="Research"
        title="Experiments and questions"
        id="research-overview-title"
        linkHref="/research/"
        linkLabel="All research"
      />
      <div class="research-overview-grid">
        {
          researchEntries.map((entry) => (
            <a class="research-overview-card" href={`/research/#${entry.data.slug}`}>
              <div class="research-overview-image">
                <LocalImage
                  src={entry.data.image}
                  alt={entry.data.image_alt}
                  sizes="(max-width: 600px) 25vw, 150px"
                />
              </div>
              <div>
                {entry.data.location && <span class="eyebrow">{entry.data.location}</span>}
                <h3>{entry.data.title}</h3>
                <p>{entry.data.summary}</p>
              </div>
            </a>
          ))
        }
      </div>

      <div class="research-highlight">
        <LocalImage
          src="/assets/images/research_photo/e181_1.png"
          alt="APS Physics Magazine 2024 highlights illustration."
          sizes="(max-width: 820px) 100vw, 640px"
        />
        <div>
          <p class="eyebrow">Research highlight</p>
          <h3>The 2024 APS Physics highlights</h3>
          <p>
            XENONnT solar B-8 CEvNS result was selected as one of the highlights of 2024 by APS
            Physics Magazine.
          </p>
          {solarPaper && (
            <a class="text-link" href={solarPaper.url} rel="noopener noreferrer">
              Read the paper <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  {
    opening && openRoles.length > 0 && (
      <section class="openings-band" aria-labelledby="openings-band-title">
        <div class="container openings-inner">
          <div>
            <h2 id="openings-band-title">Work with us.</h2>
            <p class="openings-copy">
              {openRoleLabel} applications are open. Availability was last reviewed on{' '}
              {formatIsoDate(opening.data.last_reviewed)}; please confirm current availability with
              the PI before applying.
            </p>
          </div>
          <div class="openings-actions">
            <a class="button" href="/opening/">
              How to apply <span aria-hidden="true">→</span>
            </a>
            <a class="openings-email" href={`mailto:${opening.data.contact.email}`}>
              {opening.data.contact.email}
            </a>
          </div>
        </div>
      </section>
    )
  }

  {
    latestNews.length > 0 && (
      <section class="section section-tight container" aria-labelledby="latest-news-title">
        <SectionHeading
          eyebrow="Updates"
          title="Latest news"
          id="latest-news-title"
          linkHref="/news/"
          linkLabel="News archive"
        />
        <NewsList items={latestNews} compact />
      </section>
    )
  }

  <section class="section home-activities" aria-labelledby="activities-preview-title">
    <div class="container">
      <SectionHeading
        eyebrow="Activities"
        title="Seminars, talks and teaching"
        id="activities-preview-title"
        linkHref="/activities/"
        linkLabel="View all activities"
      />
      <p class="activities-preview-intro">
        The group hosts seminars on campus, gives talks beyond our university, and teaches
        undergraduate students. Seminars, external talks and undergraduate lectures are collected
        here.
      </p>
      {
        activityPreviews.length > 0 ? (
          <ActivityList items={activityPreviews} compact />
        ) : (
          <div class="activity-category-grid" aria-label="Activity categories">
            <div class="activity-category-card">
              <h3>Seminar</h3>
              <p>Talks hosted by the group on campus.</p>
            </div>
            <div class="activity-category-card">
              <h3>External Talk</h3>
              <p>Talks given outside our university or group.</p>
            </div>
            <div class="activity-category-card">
              <h3>Undergraduate Lecture</h3>
              <p>Lectures for undergraduate students on campus.</p>
            </div>
          </div>
        )
      }
      {
        activityPreviews.length === 0 && (
          <p class="activities-preview-note">
            Seminars, external talks and undergraduate lectures will be listed here when details
            are available.
          </p>
        )
      }
    </div>
  </section>

  <section class="section home-publications" aria-labelledby="featured-publications-title">
    <div class="container">
      <SectionHeading
        eyebrow="Publications"
        title="Representative papers"
        id="featured-publications-title"
        linkHref="/publication/"
        linkLabel={`All ${publications.length} publications`}
      />
      <PublicationList items={featuredPublications} compact />
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="gallery-preview-title">
    <div class="container">
      <SectionHeading
        eyebrow="Gallery"
        title="Around the group"
        id="gallery-preview-title"
        linkHref="/gallery/"
        linkLabel="Visit the gallery"
      />
      <GalleryPreview albums={albumPreviews} limit={settings.homepage.galleryPreviewLimit} />
    </div>
  </section>
</BaseLayout>
