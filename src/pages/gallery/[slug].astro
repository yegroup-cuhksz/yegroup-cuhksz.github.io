---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LocalImage from '../../components/LocalImage.astro';
import { albums, formatAlbumDate, formatAlbumDateTime } from '../../lib/content';

export function getStaticPaths() {
  return albums.map((album) => ({
    params: { slug: album.slug },
    props: { album },
  }));
}

const { album } = Astro.props;
---

<BaseLayout
  title={album.title}
  description={album.description ?? `${album.title}: a ${album.category.toLowerCase()} album from the Neutrino & Dark Matter Group.`}
  image={album.cover}
>
  <div class="container breadcrumb">
    <a href="/gallery/">Gallery</a> / {album.title}
  </div>

  <header class="container album-header">
    <p class="eyebrow">{album.category}</p>
    <h1>{album.title}</h1>
    <div class="album-meta">
      {album.date && <time datetime={formatAlbumDateTime(album)}>{formatAlbumDate(album)}</time>}
      {album.location && <span>{album.location}</span>}
      <span>{album.photos.length} photo{album.photos.length === 1 ? '' : 's'}</span>
    </div>
    {album.description && <p class="album-description">{album.description}</p>}
  </header>

  <div class="container album-photos">
    {
      album.photos.map((photo) => (
        <figure class="album-photo">
          <a href={photo.image} aria-label={`View full-size photograph${photo.caption ? `: ${photo.caption}` : ''}`}>
            <LocalImage src={photo.image} alt={photo.alt} sizes="(max-width: 600px) 100vw, 48vw" />
          </a>
          {(photo.caption || photo.credit) && (
            <figcaption>
              {photo.caption}
              {photo.credit && <span class="photo-credit">Credit: {photo.credit}</span>}
            </figcaption>
          )}
        </figure>
      ))
    }
  </div>
</BaseLayout>
